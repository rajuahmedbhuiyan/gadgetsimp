# Copy to .env and fill in. Boot fails fast with a readable message if
# anything here is missing or malformed - see src/config/env.js.

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Number of reverse proxies in front of the app.
# 0 locally. 1 behind a single Nginx / Render / Railway / Fly proxy.
# This is what makes req.ip trustworthy, and therefore IP rate limiting
# trustworthy. Setting it too high lets clients spoof X-Forwarded-For.
TRUST_PROXY_HOPS=0

# Local mongod:
MONGODB_URI=mongodb://127.0.0.1:27017/gadgetsimp
#
# MongoDB Atlas - copy from Connect > Drivers, then:
#   1. keep the mongodb+srv:// scheme (not mongodb://)
#   2. replace <db_password> entirely, angle brackets included
#   3. add the database name before the '?', or you land in `test`
#   4. percent-encode special characters in the password:
#      @ -> %40   # -> %23   / -> %2F   : -> %3A   ? -> %3F
#
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/gadgetsimp?retryWrites=true&w=majority
#
# Auth still failing with a well-formed URI? It is Atlas-side, not the app:
#   - the user must exist under Database Access with readWrite on this cluster
#   - your IP must be allowed under Network Access (this one usually shows up
#     as a connection timeout rather than an auth error)

# Optional. Without it, rate limit counters live in process memory: they are
# lost on restart and not shared between instances. Set it in production.
# REDIS_URL=redis://127.0.0.1:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters, and the two must differ.
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_ROUNDS=12

# Comma-separated browser origins allowed to send credentials.
CORS_ORIGINS=http://localhost:3000

# Set in production if the API and frontend share a parent domain.
# COOKIE_DOMAIN=.gadgetsimp.dev

# Where the emailed verification link points - your frontend, not the API.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------- Email ----
# Signup sends a confirmation link and no account is created until it is
# clicked, so this matters more than it looks.
#
# log   = write emails to the log instead of sending (default; no account
#         needed, and the link is printed so you can click it locally)
# gmail = send through a Gmail account (free)
# smtp  = any other SMTP server
#
# 'log' is refused when NODE_ENV=production - nobody could ever register.
MAIL_PROVIDER=log

# --- Gmail (MAIL_PROVIDER=gmail) -------------------------------------------
# GMAIL_APP_PASSWORD is NOT your Google password. Google blocks account
# passwords over SMTP. To get one:
#   1. Enable 2-Step Verification: https://myaccount.google.com/signinoptions/two-step-verification
#   2. Create an App Password:     https://myaccount.google.com/apppasswords
#   3. Paste the 16 characters below (spaces are fine, they are ignored)
#
# Free Gmail sends roughly 500 messages/day; Workspace ~2000. Exceeding it
# gets sending suspended for ~24h, which breaks signup for everyone - the API
# warns in the log once 80% of MAIL_DAILY_QUOTA is used.
#
# Set MAIL_FROM to the same Gmail address, or Gmail rewrites the From header
# and messages are far more likely to be marked as spam.
# GMAIL_USER=yourname@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
MAIL_DAILY_QUOTA=500

# --- Any other SMTP host (MAIL_PROVIDER=smtp) ------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true only for port 465
# SMTP_USER=
# SMTP_PASS=

MAIL_FROM=GadgetSimp <no-reply@gadgetsimp.dev>

# ------------------------------------------------------- Facebook Login ----
# From https://developers.facebook.com/apps - Settings > Basic.
# Both must be set together, or neither. Unset disables /auth/facebook.
# The secret must never reach the browser: it is used server-side to verify
# that an access token was issued to THIS app.
# Add your frontend origin under Facebook Login > Settings > Valid OAuth
# Redirect URIs, and request the `email` permission.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

LOG_LEVEL=info

SWAGGER_ENABLED=true
RATE_LIMIT_ENABLED=true
